# Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_VOICE_CLONE_ENABLED=false

# Used only by the Supabase Edge Function, never by the frontend.
# Configure the real values with: supabase secrets set OCR_SERVICE_URL=... OCR_SERVICE_KEY=...
OCR_SERVICE_URL=https://your-ocr-service.example.com/api/ocr
OCR_SERVICE_KEY=replace-with-your-private-ocr-key

# Used only by the speak-cloned-voice Edge Function. Configure real values
# with `supabase secrets set`; never commit private credentials.
ELEVENLABS_API_KEY=replace-with-your-private-key
ELEVENLABS_VOICE_ID=replace-with-your-approved-voice-id
